<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="152dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding">

            <!-- ══ Encabezado ═══════════════════════════════════════════════ -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="12dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_action"
                    android:contentDescription="@string/back"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/accent" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/equipment_detail_title"
                    style="@style/TextScreenTitle" />
            </LinearLayout>

            <!-- ══ Identificación del equipo ════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <TextView
                    android:id="@+id/tvEquipmentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/equipment_name_text"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_confidence_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <TextView
                        android:id="@+id/tvConfidence"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textColor="@color/accent"
                        android:textSize="@dimen/equipment_confidence_text"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/academic_guide_title"
                        android:textColor="@color/accent" />

                    <TextView
                        android:id="@+id/tvSheetStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressSheet"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="12dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/accent" />

                <include
                    android:id="@+id/sectionComponents"
                    layout="@layout/item_datasheet_section" />

                <include
                    android:id="@+id/sectionProcedure"
                    layout="@layout/item_datasheet_section" />

                <include
                    android:id="@+id/sectionPpe"
                    layout="@layout/item_datasheet_section" />

                <include
                    android:id="@+id/sectionRisks"
                    layout="@layout/item_datasheet_section" />

                <include
                    android:id="@+id/sectionPractices"
                    layout="@layout/item_datasheet_section" />
            </LinearLayout>

            <!-- ══ Acciones ═════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnCopy"
                    style="@style/CircleAction"
                    android:layout_marginHorizontal="12dp"
                    android:contentDescription="@string/copy"
                    android:src="@drawable/ic_copy"
                    android:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnShare"
                    style="@style/CircleAction"
                    android:layout_marginHorizontal="12dp"
                    android:contentDescription="@string/share"
                    android:src="@drawable/ic_share"
                    android:tint="@color/text_primary" />

                <ImageButton
                    android:id="@+id/btnScanAgain"
                    style="@style/CircleAction"
                    android:layout_marginHorizontal="12dp"
                    android:contentDescription="@string/scan_again"
                    android:src="@drawable/ic_scan_frame"
                    android:tint="@color/text_primary" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══ Barra inferior ═══════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/bottomArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom">

        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_bottom_bar"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/navScan"
                style="@style/BottomBarItem"
                android:contentDescription="@string/nav_scan"
                android:src="@drawable/ic_scan_frame"
                android:tint="@color/text_tertiary" />

            <Space
                android:layout_width="88dp"
                android:layout_height="match_parent" />

            <ImageButton
                android:id="@+id/navLastResult"
                style="@style/BottomBarItem"
                android:contentDescription="@string/nav_last_result"
                android:src="@drawable/ic_document"
                android:tint="@color/accent" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabOpenChat"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="46dp"
            android:contentDescription="@string/open_chat"
            android:src="@drawable/ic_chat"
            app:backgroundTint="@color/accent"
            app:borderWidth="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle"
            app:elevation="8dp"
            app:fabCustomSize="64dp"
            app:maxImageSize="26dp"
            app:tint="@color/on_accent" />
    </FrameLayout>

</FrameLayout>
