<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ══ Portada ══════════════════════════════════════════════════════════
         La foto sangra hasta el borde superior, por debajo de la barra de
         estado. El degradado que va encima la funde con el fondo. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_hero_height"
        android:layout_gravity="top"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_lab" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_hero_height"
        android:layout_gravity="top"
        android:background="@drawable/bg_hero_scrim" />

    <ScrollView
        android:id="@+id/scrollHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <!-- El contenido va alineado a la izquierda: con todo centrado, cada
             bloque flotaba por su cuenta y no se leía un orden. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="@dimen/home_hero_overlap"
            android:paddingBottom="28dp">

            <!-- ══ Marca ════════════════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="66dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/home_logo_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/uteq_logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/home_institution"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                style="@style/TextScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/home_title"
                android:textSize="30sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/home_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <!-- ══ Acción principal ═════════════════════════════════════════
                 Va antes de las explicaciones: es a lo que se entra. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartScan"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="@string/home_start_scan"
                android:textColor="@color/on_accent"
                android:textSize="15sp"
                app:backgroundTint="@color/accent"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_scan_frame"
                app:iconGravity="textStart"
                app:iconTint="@color/on_accent" />

            <!-- ══ Atajo al último equipo ═══════════════════════════════════
                 Solo aparece si ya se escaneó algo en esta instalación. -->
            <LinearLayout
                android:id="@+id/cardLastEquipment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_action"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_chat"
                    android:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextFieldValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_continue_with" />

                    <TextView
                        android:id="@+id/tvLastEquipment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ══ Cómo funciona ════════════════════════════════════════════
                 Dos tarjetas separadas en vez de una sola partida por una
                 línea: cada capacidad se lee como una pieza propia. -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/home_how_it_works" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_action"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_scan_frame"
                    android:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextFieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_detection_title" />

                    <TextView
                        style="@style/TextFieldValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_detection_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:padding="18dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_action"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_chat"
                    android:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextFieldLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/home_assistant_title" />

                    <TextView
                        style="@style/TextFieldValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/home_assistant_body" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/home_footer"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
