<?xml version="1.0" encoding="utf-8"?>
<!-- Degradado que funde la foto con el fondo de la app: oscurece lo suficiente
     arriba para que se lean la barra de estado y el distintivo, se abre en el
     centro para dejar ver el laboratorio, y termina en el color de fondo para
     que no haya un corte visible donde acaba la imagen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#B00F0F10"
        android:centerY="0.48"
        android:endColor="@color/bg"
        android:startColor="#8A000000"
        android:type="linear" />
</shape>
